# Copy to a private .env.local. Values below are intentionally empty; never commit real credentials.
# local is generated by npm run account:setup; hosted is enabled only after project/SMTP acceptance.
KOOCH_ACCOUNT_MODE=
KOOCH_APP_ORIGIN=
KOOCH_AUTH_URL=
KOOCH_AUTH_PUBLISHABLE_KEY=
KOOCH_AUTH_SERVICE_KEY=
KOOCH_DATABASE_URL=
# Hosted only: PEM root CA downloaded from the database provider's dashboard.
KOOCH_DATABASE_CA_CERT=
KOOCH_GOOGLE_AUTH_ENABLED=false
KOOCH_MIGRATION_DATABASE_URL=
KOOCH_SESSION_ENCRYPTION_KEY=

# AI stays off until the committed policy has an accepted header, scoped IAM and tariff.
# Raw existing Arvan key, server only. No NEXT_PUBLIC_ prefix.
KOOCH_ARVAN_API_KEY=
# Independent stable 32-byte hex key for accounting pseudonyms/idempotency.
# Do not rotate while requests are outstanding without an accounting migration.
KOOCH_AI_ACCOUNTING_KEY=
