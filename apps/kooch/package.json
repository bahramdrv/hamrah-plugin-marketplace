{
  "name": "kooch-self-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3100",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "refresh:data": "node --import tsx scripts/sync-evidence.ts",
    "account:setup": "node --import tsx scripts/setup-local-account.ts",
    "account:migrate": "node --env-file=.env.local --import tsx scripts/migrate-account.ts",
    "account:purge": "node --env-file=.env.local --import tsx scripts/purge-inactive.ts",
    "test:account": "node --env-file=.env.local --import tsx --test tests/account.test.ts",
    "evidence:sync": "node --import tsx scripts/sync-evidence.ts"
  },
  "dependencies": {
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
