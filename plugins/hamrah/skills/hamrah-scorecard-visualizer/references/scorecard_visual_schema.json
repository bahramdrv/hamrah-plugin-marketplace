{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hamrah Scorecard Visual Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "case_label", "generated_at", "routes", "next_steps", "disclaimer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "case_label": {"type": "string", "minLength": 1, "maxLength": 50},
    "generated_at": {"type": "string"},
    "routes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["country", "route", "official_status", "base_fit", "community_adjustment", "practical_fit", "confidence", "reasons", "blocker", "next_action"], "properties": {
      "country": {"type": "string", "maxLength": 40},
      "route": {"type": "string", "maxLength": 70},
      "official_status": {"enum": ["PASS", "POSSIBLE", "FAIL", "UNKNOWN"]},
      "base_fit": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
      "community_adjustment": {"enum": [0, -5, -10, -15, -20]},
      "practical_fit": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
      "confidence": {"enum": ["low", "medium", "high"]},
      "reasons": {"type": "array", "maxItems": 2, "items": {"type": "string", "maxLength": 150}},
      "blocker": {"type": ["string", "null"], "maxLength": 160},
      "next_action": {"type": "string", "maxLength": 160}
    }}},
    "next_steps": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 160}},
    "disclaimer": {"type": "string", "minLength": 1, "maxLength": 240}
  }
}
