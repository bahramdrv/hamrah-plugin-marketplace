{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hamrah Academic Program Matches",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "profile_reference", "search_scope", "programs", "warnings"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "profile_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fields_used", "missing_information"],
      "properties": {
        "kind": {"enum": ["canonical", "minimal"]},
        "fields_used": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_information": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "search_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["country", "degree_level", "field"],
      "properties": {
        "country": {"type": "string", "minLength": 2},
        "degree_level": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1}
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["program_id", "institution", "country", "program_title", "degree_level", "field", "official_program_url", "match_status", "match_reasons", "gaps", "admissions", "affordability", "funding", "iranian_evidence", "immigration_context", "preference_match", "sources", "checked_at"],
        "properties": {
          "program_id": {"type": "string", "minLength": 1},
          "institution": {"type": "string", "minLength": 1},
          "country": {"type": "string", "minLength": 2},
          "program_title": {"type": "string", "minLength": 1},
          "degree_level": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "official_program_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "match_status": {
            "enum": ["supported_fit", "conditional_fit", "insufficient_evidence"],
            "description": "Academic admission fit only; funding, affordability, immigration and preferences are separate."
          },
          "match_reasons": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["reason", "source_urls"],
              "properties": {
                "reason": {"type": "string", "minLength": 1},
                "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}}
              }
            }
          },
          "gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "admissions": {
            "type": "object", "additionalProperties": false,
            "required": ["requirements", "application", "deadline"],
            "properties": {
              "requirements": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["criterion", "source_url"],
                  "properties": {
                    "criterion": {"type": "string", "minLength": 1},
                    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
                  }
                }
              },
              "application": {
                "type": "object", "additionalProperties": false,
                "required": ["status", "intake", "source_url"],
                "properties": {
                  "status": {"enum": ["open", "not_yet_open", "closed", "unknown"]},
                  "intake": {"type": ["string", "null"]},
                  "source_url": {"type": ["string", "null"], "format": "uri"}
                }
              },
              "deadline": {
                "type": "object", "additionalProperties": false,
                "required": ["status", "date", "intake", "source_url"],
                "properties": {
                  "status": {"enum": ["verified", "expired", "unknown"]},
                  "date": {"type": ["string", "null"], "format": "date"},
                  "intake": {"type": ["string", "null"]},
                  "source_url": {"type": ["string", "null"], "format": "uri"}
                }
              }
            }
          },
          "affordability": {
            "type": "object", "additionalProperties": false,
            "required": ["tuition", "notes"],
            "properties": {
              "tuition": {
                "type": "object", "additionalProperties": false,
                "required": ["status", "amount", "currency", "period", "source_url"],
                "properties": {
                  "status": {"enum": ["verified", "none", "unknown"]},
                  "amount": {"type": ["number", "null"], "minimum": 0},
                  "currency": {"type": ["string", "null"]},
                  "period": {"type": ["string", "null"]},
                  "source_url": {"type": ["string", "null"], "format": "uri"}
                }
              },
              "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "funding": {"$ref": "#/$defs/funding"},
          "iranian_evidence": {"$ref": "#/$defs/iranian_evidence"},
          "immigration_context": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "notes"],
            "properties": {
              "status": {"enum": ["assessed", "not_assessed"]},
              "notes": {"type": ["string", "null"]}
            }
          },
          "preference_match": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "reasons"],
            "properties": {
              "status": {"enum": ["match", "partial", "unknown"]},
              "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "url", "checked_at"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "checked_at": {"type": "string", "format": "date"}
              }
            }
          },
          "checked_at": {"type": "string", "format": "date"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "funding": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "details", "source_url"],
      "properties": {
        "status": {"enum": ["verified", "competitive", "none", "unknown"]},
        "details": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "iranian_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "details", "source_url"],
      "properties": {
        "status": {"enum": ["explicit_permission", "explicit_restriction", "unknown"]},
        "details": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  }
}
