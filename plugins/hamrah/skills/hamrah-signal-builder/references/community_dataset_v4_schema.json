    "route_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "country_code",
        "routes",
        "claim_type",
        "process_stage",
        "statement_en",
        "opposing_evidence_ids",
        "evidence_ids",
        "lifecycle",
        "validation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "country_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 3
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "official_rule",
            "financial_requirement",
            "operational_pattern",
            "anecdotal_pattern",
            "opportunity",
            "risk",
            "workaround"
          ],
          "description": "official_rule and financial_requirement state official rules; the other types are observed patterns, opportunities, risks, or workarounds and are never official."
        },
        "process_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicant_scope": {
          "$ref": "#/$defs/applicantScope",
          "description": "Applicants the claim is limited to; omit when it applies to all applicants."
        },
        "statement_en": {
          "type": "string",
          "minLength": 1
        },
        "opposing_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "minItems": 1
        },
        "lifecycle": {
          "$ref": "#/$defs/claimLifecycle"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    },
    "answerTargetId": {
      "type": "string",
      "pattern": "^(sig|clm)_[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "answerLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
