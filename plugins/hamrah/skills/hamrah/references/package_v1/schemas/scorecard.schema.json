{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hamrah Normalized Scorecard",
  "type": "object",
  "required": [
    "case_id",
    "status",
    "generated_at",
    "ranked_routes",
    "overall"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROVISIONAL",
        "FINAL"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "overall": {
      "type": "object",
      "required": [
        "best_route",
        "backup_route",
        "biggest_blocker",
        "confidence"
      ],
      "properties": {
        "best_route": {
          "type": [
            "string",
            "null"
          ]
        },
        "backup_route": {
          "type": [
            "string",
            "null"
          ]
        },
        "biggest_blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": true
    },
    "ranked_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "country",
          "route",
          "eligibility",
          "base_fit",
          "community_friction",
          "practical_fit",
          "confidence"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "country": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "eligibility": {
            "enum": [
              "PASS",
              "LIKELY",
              "UNCLEAR",
              "FAIL"
            ]
          },
          "base_fit": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "community_friction": {
            "enum": [
              0,
              -5,
              -10,
              -15,
              -20
            ]
          },
          "practical_fit": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "main_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "warning": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}