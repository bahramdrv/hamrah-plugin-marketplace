      "direct_or_second_hand": "direct",
      "supports_or_contradicts": "supports",
      "independence_group": "teheran.diplo.de:tehran_visa",
      "copy_risk": "low",
      "evidence_summary": "The embassy's visa section in Tehran works in restricted operation with limited appointments and no reliable date for returning to normal service. For residents of Iran, study appointments go to people already on the waiting list on 18 January 2026 and to Master and PhD applicants registered on the new waiting lists since 15 July 2026. For employment outside the accelerated skilled-worker procedure and for other national visa purposes, new registrants since 15 July 2026 have no foreseeable appointment date. Applications at other missions are rejected for lack of jurisdiction, and longer processing times are expected.",
      "supersedes": null,
      "validation": {
        "status": "validated",
        "privacy_status": "pass",
        "validated_at": "2026-09-25T17:46:55Z"
      }
    },
    {
      "id": "evd_b9a50307f7b2a2dfc0631ac841669dc3",
