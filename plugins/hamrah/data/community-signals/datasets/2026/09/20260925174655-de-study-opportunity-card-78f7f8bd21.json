      "direct_or_second_hand": "direct",
      "supports_or_contradicts": "supports",
      "independence_group": "gesetze-im-internet.de:law_16b",
      "copy_risk": "low",
      "evidence_summary": "Section 16b of the Residence Act grants a residence permit for full-time study to applicants admitted by a state or state-recognised institution, sets validity at usually two years and at least one year, and allows employment of up to 140 working days a year, with student jobs not counted.",
      "supersedes": null,
      "validation": {
        "status": "validated",
        "privacy_status": "pass",
        "validated_at": "2026-09-25T17:46:55Z"
      }
