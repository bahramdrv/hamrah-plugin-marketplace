      "source_url": "https://www.gesetze-im-internet.de/aufenthg_2004/__16b.html",
      "retrieved_at": "2026-09-25T17:43:16Z",
      "published_at": null,
      "event_date": null,
      "content_hash": "sha256:d2cb2d5e807a370a118d4fa604422e9a26e12b3a7a9278fca51c92517c6686cf",
      "source_type": "official_government",
