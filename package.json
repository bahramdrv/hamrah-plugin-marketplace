{
  "name": "hamrah-chatgpt-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP endpoint for the Hamrah ChatGPT app.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test plugins/hamrah/mcp/tests/*.test.mjs web/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:live": "node scripts/verify-live-mcp.mjs",
    "verify:live:opportunities": "node scripts/verify-live-opportunities.mjs",
    "verify:live:supervisors": "node scripts/verify-live-supervisors.mjs",
    "verify:live:plugin": "node scripts/verify-live-plugin-bundle.mjs",
    "check:static": "find plugins web packages scripts -name '*.mjs' -type f -exec node --check {} \\;"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "express": "5.2.1",
    "tldts": "7.4.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@immi/hamrah-intake-contract": "file:./packages/hamrah-intake-contract"
  }
}
